# Stripe / Netlify 环境变量（不要填入真实密钥后提交）

# Stripe Restricted API Key（rk_test_ / rk_live_），权限需包含 Checkout Sessions 写、Webhooks 读
STRIPE_SECRET_KEY=

# Stripe Webhook signing secret（whsec_）
STRIPE_WEBHOOK_SECRET=

# 可选：Dashboard 里创建的 Payment Method Configuration ID
# 境外（HKD 卡）与境内（CNY + UnionPay）分开
STRIPE_PMC_OVERSEAS=
STRIPE_PMC_CHINA=

# 员工后台密码（/staff/pay）
STAFF_GATE_SECRET=

# 联系表单发信（Resend）
RESEND_API_KEY=
CONTACT_FROM_EMAIL=HKCAS Website <noreply@hkcas.org>

# 站点 URL，本地 netlify dev 一般会自动注入 URL
SITE_URL=http://localhost:8888
